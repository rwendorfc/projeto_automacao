# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Telegram Bot (recomendado — mais fácil)
# 1. Abra o Telegram e procure por @BotFather
# 2. Envie /newbot e siga as instruções para criar seu bot
# 3. Copie o token fornecido (formato: 123456789:AAF...)
# 4. Mande qualquer mensagem para o seu bot
# 5. Acesse https://api.telegram.org/bot<TOKEN>/getUpdates para obter o chat_id
TELEGRAM_BOT_TOKEN=        # ex: 123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=          # ex: 987654321

# WhatsApp via CallMeBot (alternativo)
WHATSAPP_PHONE=+5571996697450
CALLMEBOT_API_KEY=

# NewsAPI (opcional — aumenta cobertura de notícias)
NEWSAPI_KEY=
