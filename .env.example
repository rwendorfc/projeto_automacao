# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# WhatsApp via CallMeBot (gratuito)
# Ativação: salve +34 644 59 67 47 como "CallMeBot" no WhatsApp e envie:
#   "I allow callmebot to send me messages"
# O bot responderá com sua API key em alguns minutos.
WHATSAPP_PHONE=+5571996697450
CALLMEBOT_API_KEY=         # cole aqui a chave que o CallMeBot enviar

# NewsAPI (opcional — aumenta cobertura de notícias)
# Cadastro gratuito em https://newsapi.org/register
NEWSAPI_KEY=
